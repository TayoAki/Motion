PORT=4310
APP_URL=http://localhost:4310
# Optional server-side credentials. Never use VITE_ variables for secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Set to 1 behind an HTTPS reverse proxy in production.
COOKIE_SECURE=0
# Email: verify a sending domain with Resend before enabling live delivery.
RESEND_API_KEY=
MAIL_FROM=
REQUIRE_EMAIL_VERIFICATION=0
# Explicit local-only development preview; never enable on a public service.
DEV_EMAIL_PREVIEW=0
# Billing: configure matching recurring Stripe prices and a 2024-06-20 webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=
# Outstand managed YouTube integration; active Outstand subscription required.
# Generate a server-side key with account, media-upload, and publishing permissions.
OUTSTAND_API_KEY=
